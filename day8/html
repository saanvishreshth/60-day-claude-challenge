/* ============ ORB ============ */
function renderOrb(){
  const avg = Math.round(CITIES.reduce((s,c)=>s+c.overall,0)/CITIES.length);
  const circumference = 2*Math.PI*88;
  const offset = circumference * (1 - avg/100);
  const circle = document.getElementById('orbCircle');
  circle.setAttribute('stroke-dasharray', `${circumference} ${circumference}`);
  circle.setAttribute('stroke-dashoffset', offset);
  const g = grade(avg);
  const color = gradeColor(g);
  circle.setAttribute('stroke', color);
  document.getElementById('orbGlow').style.background = color;
  document.getElementById('orbScore').textContent = avg;
  document.getElementById('orbScore').style.color = color;
}

/* ============ COMPARISON ============ */
function renderCompare(){
  const panel = document.getElementById('comparePanel');
  if(!state.compareMode){ panel.style.display='none'; return; }
  panel.style.display='block';
  const a = CITIES.find(x=>x.name===state.selectedCity);
  const b = CITIES.find(x=>x.name===state.compareCity);
  document.getElementById('compareTitle').textContent = `${a.name} vs ${b.name}`;
  compareChart.data.datasets = [
    { label:a.name, data:[a.aqi, a.pm25, a.pm10, a.water, a.overall], backgroundColor:'#2dd4bf', borderRadius:6 },
    { label:b.name, data:[b.aqi, b.pm25, b.pm10, b.water, b.overall], backgroundColor:'#8b7cf6', borderRadius:6 },
  ];
  compareChart.update();
}

/* ============ FULL RENDER ============ */
function renderAll(){
  renderCharts();
  renderCityCards();
  renderHealthAnalysis();
  renderReportCard();
  renderRecommendations();
  renderCompare();
}

/* ============ EVENT WIRING ============ */
citySelect.addEventListener('change', e=>{ state.selectedCity = e.target.value; renderAll(); });
compareSelect.addEventListener('change', e=>{ state.compareCity = e.target.value; renderCompare(); });

document.getElementById('compareToggle').addEventListener('change', e=>{
  state.compareMode = e.target.checked;
  document.getElementById('compareCityGroup').style.display = state.compareMode ? 'flex':'none';
  renderCompare();
});

document.getElementById('pollutantSelect').addEventListener('change', e=>{
  state.pollutant = e.target.value;
  renderCharts();
});

const aqiMinEl = document.getElementById('aqiMin');
const aqiMaxEl = document.getElementById('aqiMax');
function updateRangeLabel(){
  let min = parseInt(aqiMinEl.value), max = parseInt(aqiMaxEl.value);
  if(min>max){ [min,max] = [max,min]; }
  state.aqiMin = min; state.aqiMax = max;
  document.getElementById('aqiRangeVal').textContent = `${min} – ${max}`;
  renderCharts();
  renderCityCards();
}
aqiMinEl.addEventListener('input', updateRangeLabel);
aqiMaxEl.addEventListener('input', updateRangeLabel);

document.querySelectorAll('#riskChips .chip').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    const r = chip.dataset.risk;
    if(state.risks.has(r)){
      if(state.risks.size>1){ state.risks.delete(r); chip.classList.remove('active'); }
    } else {
      state.risks.add(r); chip.classList.add('active');
    }
    renderCharts();
    renderCityCards();
  });
});

document.getElementById('copySummaryBtn').addEventListener('click', ()=>{
  const summary =
`🌍 Personal Environmental Health Analyzer — Snapshot 12 Jun 2026
Cities analyzed: 15 | Average AQI: 103 (Moderate)
Cleanest: Shillong (AQI 28) | Most Polluted: Dhanbad (AQI 195)
National Avg Environmental Health Score: 56/100
Most surprising: Shillong beats every major metro on air & water quality.
#AirQuality #EnvironmentalHealth #AQI #Sustainability`;
  navigator.clipboard.writeText(summary).then(()=>{
    const btn = document.getElementById('copySummaryBtn');
    const old = btn.textContent;
    btn.textContent = '✅ Copied!';
    setTimeout(()=>btn.textContent = old, 1800);
  });
});

/* ============ INITIAL RENDER ============ */
renderOrb();
renderAll();
</script>

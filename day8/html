<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>🌍 Personal Environmental Health Analyzer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  :root{
    --bg:#0a0e1a;
    --bg-soft:#0d1322;
    --surface:#131a2c;
    --surface-2:#1a2238;
    --border:#262f47;
    --text:#edf1f7;
    --text-dim:#8d97b3;
    --text-faint:#5d6783;
    --brand:#2dd4bf;
    --brand-2:#8b7cf6;

    --good:#4ade80;
    --satisfactory:#a3e635;
    --moderate:#facc15;
    --poor:#fb923c;
    --verypoor:#ef4444;
    --severe:#a8323d;

    --r-low:#4ade80;
    --r-mod:#facc15;
    --r-high:#ef4444;
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:radial-gradient(ellipse 1200px 800px at 20% -10%, rgba(45,212,191,0.10), transparent 60%),
                radial-gradient(ellipse 1000px 700px at 100% 0%, rgba(139,124,246,0.10), transparent 55%),
                var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
    padding-bottom:60px;
  }
  h1,h2,h3,h4{font-family:'Space Grotesk',sans-serif; letter-spacing:-0.01em;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:var(--brand);}

  /* ============ LAYOUT ============ */
  .wrap{max-width:1280px; margin:0 auto; padding:0 24px;}
  section{margin-top:36px;}
  .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:11px; letter-spacing:0.18em; text-transform:uppercase;
    color:var(--brand); margin-bottom:8px; font-weight:700;
  }
  .section-title{font-size:22px; font-weight:700; margin-bottom:4px;}
  .section-sub{color:var(--text-dim); font-size:13.5px; margin-bottom:18px;}

  /* ============ TOPBAR ============ */
  .topbar{
    padding:22px 0 18px;
    border-bottom:1px solid var(--border);
    display:flex; flex-wrap:wrap; gap:14px;
    align-items:flex-end; justify-content:space-between;
  }
  .topbar .brand{display:flex; align-items:center; gap:12px;}
  .brand-mark{
    width:42px; height:42px; border-radius:12px;
    background:linear-gradient(135deg, var(--brand), var(--brand-2));
    display:flex; align-items:center; justify-content:center; font-size:22px;
    box-shadow:0 8px 24px rgba(45,212,191,0.25);
  }
  .brand h1{font-size:21px; font-weight:700;}
  .brand p{font-size:12px; color:var(--text-dim); font-family:'JetBrains Mono',monospace;}
  .topbar .meta{font-size:12px; color:var(--text-dim); text-align:right; max-width:360px;}
  .topbar .meta b{color:var(--text);}

  /* ============ HERO ============ */
  .hero{
    display:grid; grid-template-columns: 1.5fr 1fr; gap:24px;
    background:linear-gradient(160deg, var(--surface) 0%, var(--bg-soft) 100%);
    border:1px solid var(--border); border-radius:20px; padding:28px;
    position:relative; overflow:hidden;
  }
  .hero::before{
    content:''; position:absolute; inset:0;
    background:radial-gradient(circle at 90% 10%, rgba(45,212,191,0.10), transparent 45%);
    pointer-events:none;
  }
  .hero-text .pill{
    display:inline-block; padding:4px 12px; border-radius:999px;
    background:rgba(45,212,191,0.12); border:1px solid rgba(45,212,191,0.3);
    color:var(--brand); font-size:11.5px; font-weight:700; font-family:'JetBrains Mono',monospace;
    letter-spacing:0.08em; margin-bottom:14px;
  }
  .hero-text h2{font-size:30px; line-height:1.2; margin-bottom:12px;}
  .hero-text h2 span{color:var(--brand);}
  .hero-text p{color:var(--text-dim); font-size:14.5px; margin-bottom:10px;}
  .hero-actions{display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;}
  .btn{
    border:1px solid var(--border); background:var(--surface-2); color:var(--text);
    padding:10px 16px; border-radius:10px; font-size:13px; font-weight:600;
    cursor:pointer; transition:all .15s ease; font-family:'Inter',sans-serif;
  }
  .btn:hover{border-color:var(--brand); color:var(--brand); transform:translateY(-1px);}
  .btn.primary{background:linear-gradient(135deg, var(--brand), #1ea89a); color:#04201d; border:none;}
  .btn.primary:hover{filter:brightness(1.08); color:#04201d;}

  /* ORB - signature element */
  .orb-card{display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; z-index:1;}
  .orb-wrap{position:relative; width:200px; height:200px;}
  .orb-wrap svg{transform:rotate(-90deg); width:200px; height:200px;}
  .orb-bg{fill:none; stroke:var(--surface-2); stroke-width:10;}
  .orb-fg{fill:none; stroke-width:10; stroke-linecap:round; transition:stroke-dasharray 1s ease, stroke 0.6s ease;}
  .orb-glow{
    position:absolute; inset:14px; border-radius:50%;
    filter:blur(18px); opacity:0.5; transition:background 0.6s ease;
    animation:breathe 4.2s ease-in-out infinite;
  }
  @keyframes breathe{ 0%,100%{transform:scale(0.92); opacity:0.35;} 50%{transform:scale(1.05); opacity:0.6;} }
  .orb-center{
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
  }
  .orb-center .score{font-family:'JetBrains Mono',monospace; font-size:42px; font-weight:700;}
  .orb-center .label{font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.12em; margin-top:2px;}
  .orb-caption{margin-top:14px; font-size:12.5px; color:var(--text-dim); text-align:center; max-width:220px;}

  /* ============ METRIC CARDS ============ */
  .metrics-grid{
    display:grid; grid-template-columns:repeat(5, 1fr); gap:14px;
  }
  .metric{
    background:var(--surface); border:1px solid var(--border); border-radius:14px;
    padding:18px; transition:transform .15s ease, border-color .15s ease;
  }
  .metric:hover{transform:translateY(-3px); border-color:var(--brand);}
  .metric .m-icon{font-size:20px; margin-bottom:8px; display:block;}
  .metric .m-val{font-family:'JetBrains Mono',monospace; font-size:26px; font-weight:700;}
  .metric .m-label{font-size:11.5px; color:var(--text-dim); margin-top:4px; text-transform:uppercase; letter-spacing:0.06em;}
  .metric .m-sub{font-size:12px; color:var(--text-faint); margin-top:6px;}

  /* ============ FILTERS ============ */
  .filters-card{
    background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:20px 22px;
    display:flex; flex-wrap:wrap; gap:22px; align-items:flex-end;
  }
  .filter-group{display:flex; flex-direction:column; gap:8px; min-width:160px;}
  .filter-group label{font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.08em; font-weight:700;}
  select, input[type=number]{
    background:var(--surface-2); border:1px solid var(--border); color:var(--text);
    padding:9px 12px; border-radius:8px; font-size:13px; font-family:'Inter',sans-serif;
  }
  select:focus, input:focus{outline:2px solid var(--brand); outline-offset:1px;}
  .range-row{display:flex; align-items:center; gap:8px;}
  .range-row input[type=range]{width:110px; accent-color:var(--brand);}
  .range-vals{font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--text-dim); white-space:nowrap;}
  .chip-row{display:flex; gap:8px; flex-wrap:wrap;}
  .chip{
    padding:7px 13px; border-radius:999px; border:1px solid var(--border); background:var(--surface-2);
    font-size:12px; font-weight:600; cursor:pointer; transition:all .15s ease; user-select:none;
    color:var(--text-dim);
  }
  .chip.active{border-color:var(--brand); color:var(--brand); background:rgba(45,212,191,0.10);}
  .toggle-row{display:flex; align-items:center; gap:10px;}
  .switch{position:relative; width:42px; height:24px;}
  .switch input{opacity:0; width:0; height:0;}
  .slider-track{
    position:absolute; cursor:pointer; inset:0; background:var(--surface-2); border:1px solid var(--border);
    border-radius:999px; transition:.2s;
  }
  .slider-track:before{
    content:""; position:absolute; width:16px; height:16px; left:3px; bottom:3px; background:var(--text-dim);
    border-radius:50%; transition:.2s;
  }
  .switch input:checked + .slider-track{background:rgba(45,212,191,0.18); border-color:var(--brand);}
  .switch input:checked + .slider-track:before{transform:translateX(18px); background:var(--brand);}
  #compareCityGroup{display:none;}

  /* ============ CHARTS ============ */
  .charts-grid{
    display:grid; grid-template-columns:repeat(2, 1fr); gap:16px;
  }
  .chart-card{
    background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:18px;
  }
  .chart-card.wide{grid-column:1 / -1;}
  .chart-card h3{font-size:14px; font-weight:700; margin-bottom:2px;}
  .chart-card .ch-sub{font-size:11.5px; color:var(--text-faint); margin-bottom:10px;}
  .chart-card canvas{max-height:280px;}

  /* ============ CITY CARDS ============ */
  .city-grid{
    display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:14px;
  }
  .city-card{
    background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:16px;
    cursor:pointer; transition:all .15s ease; position:relative; overflow:hidden;
  }
  .city-card:hover{transform:translateY(-3px); border-color:var(--brand);}
  .city-card.selected{border-color:var(--brand); box-shadow:0 0 0 1px var(--brand), 0 10px 30px rgba(45,212,191,0.12);}
  .city-card .top-row{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;}
  .city-card .c-name{font-size:15px; font-weight:700;}
  .city-card .c-state{font-size:11px; color:var(--text-faint);}
  .badge{
    font-size:10.5px; font-weight:700; padding:4px 9px; border-radius:999px; color:#0a0e1a;
    text-transform:uppercase; letter-spacing:0.04em; white-space:nowrap;
  }
  .city-card .stat-row{display:flex; justify-content:space-between; font-size:12.5px; color:var(--text-dim); margin-top:4px;}
  .city-card .stat-row b{font-family:'JetBrains Mono',monospace; color:var(--text); font-weight:700;}
  .city-card .scores{display:flex; gap:8px; margin-top:12px;}
  .score-pill{flex:1; background:var(--surface-2); border-radius:8px; padding:8px; text-align:center;}
  .score-pill .sp-val{font-family:'JetBrains Mono',monospace; font-weight:700; font-size:15px;}
  .score-pill .sp-label{font-size:10px; color:var(--text-faint); text-transform:uppercase; letter-spacing:0.05em;}

  /* ============ HEALTH ANALYSIS ============ */
  .health-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
  .health-card{background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:20px;}
  .health-card h3{font-size:15px; margin-bottom:4px;}
  .health-card .hc-sub{font-size:12px; color:var(--text-faint); margin-bottom:14px;}
  .impact-row{
    display:flex; justify-content:space-between; align-items:flex-start; gap:10px;
    padding:11px 0; border-bottom:1px solid var(--border);
  }
  .impact-row:last-child{border-bottom:none;}
  .impact-row .imp-label{font-size:13px; font-weight:600; min-width:120px;}
  .impact-row .imp-text{font-size:12.5px; color:var(--text-dim); flex:1;}
  .risk-tag{font-size:13px; flex-shrink:0;}

  /* ============ REPORT CARD ============ */
  .report-card{
    background:linear-gradient(160deg, var(--surface) 0%, var(--bg-soft) 100%);
    border:1px solid var(--border); border-radius:18px; padding:26px;
  }
  .rc-top{display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:14px; margin-bottom:20px;}
  .rc-top .rc-city{font-size:20px; font-weight:700;}
  .rc-top .rc-score-big{font-family:'JetBrains Mono',monospace; font-size:46px; font-weight:700; color:var(--brand);}
  .rc-bars{display:grid; grid-template-columns:repeat(3, 1fr); gap:16px; margin-bottom:20px;}
  .rc-bar-item .rc-bar-label{display:flex; justify-content:space-between; font-size:12.5px; margin-bottom:6px; color:var(--text-dim);}
  .rc-bar-label b{color:var(--text); font-family:'JetBrains Mono',monospace;}
  .rc-bar-track{height:8px; background:var(--surface-2); border-radius:999px; overflow:hidden;}
  .rc-bar-fill{height:100%; border-radius:999px; transition:width 1s ease;}
  .grades-grid{display:grid; grid-template-columns:repeat(4, 1fr); gap:12px;}
  .grade-box{background:var(--surface-2); border:1px solid var(--border); border-radius:12px; padding:14px; text-align:center;}
  .grade-box .g-letter{font-family:'JetBrains Mono',monospace; font-size:28px; font-weight:700;}
  .grade-box .g-label{font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.06em; margin-top:4px;}

  /* ============ INSIGHTS ============ */
  .insights-grid{display:grid; grid-template-columns:repeat(2, 1fr); gap:16px;}
  .insight-card{background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:18px;}
  .insight-card h4{font-size:13.5px; margin-bottom:10px; display:flex; align-items:center; gap:6px;}
  .insight-list{list-style:none; display:flex; flex-direction:column; gap:8px;}
  .insight-list li{
    display:flex; justify-content:space-between; align-items:center; font-size:13px;
    background:var(--surface-2); padding:8px 12px; border-radius:8px;
  }
  .insight-list li b{font-family:'JetBrains Mono',monospace;}
  .insight-card p{font-size:13px; color:var(--text-dim);}
  .insight-card.full{grid-column:1/-1;}

  /* ============ RECOMMENDATIONS ============ */
  .rec-grid{display:grid; grid-template-columns:repeat(3, 1fr); gap:14px;}
  .rec-card{background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:16px;}
  .rec-card h4{font-size:13px; margin-bottom:10px; display:flex; align-items:center; gap:6px;}
  .rec-card ul{list-style:none; display:flex; flex-direction:column; gap:8px;}
  .rec-card ul li{font-size:12.5px; color:var(--text-dim); padding-left:18px; position:relative;}
  .rec-card ul li::before{content:'→'; position:absolute; left:0; color:var(--brand); font-weight:700;}

  /* ============ FOOTER ============ */
  footer{
    margin-top:40px; padding-top:20px; border-top:1px solid var(--border);
    font-size:12px; color:var(--text-faint); display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;
  }
  footer a{color:var(--text-dim);}

  /* ============ RESPONSIVE ============ */
  @media (max-width:980px){
    .hero{grid-template-columns:1fr;}
    .metrics-grid{grid-template-columns:repeat(2, 1fr);}
    .charts-grid{grid-template-columns:1fr;}
    .health-grid{grid-template-columns:1fr;}
    .rc-bars{grid-template-columns:1fr;}
    .grades-grid{grid-template-columns:repeat(2,1fr);}
    .insights-grid{grid-template-columns:1fr;}
    .rec-grid{grid-template-columns:1fr;}
  }
  @media (max-width:480px){
    .metrics-grid{grid-template-columns:1fr 1fr;}
    .wrap{padding:0 14px;}
    .topbar{flex-direction:column; align-items:flex-start;}
    .topbar .meta{text-align:left;}
  }

  /* fade in */
  .fade-in{animation:fadeIn .6s ease both;}
  @keyframes fadeIn{from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);}}
</style>
</head>
<body>

<div class="wrap">

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="brand">
      <div class="brand-mark">🌍</div>
      <div>
        <h1>Personal Environmental Health Analyzer</h1>
        <p>Air + Water Quality Intelligence · India</p>
      </div>
    </div>
    <div class="meta">
      Data snapshot: <b>12 June 2026</b> · Cities analyzed: <b>15</b><br>
      Sources: aqi.in live dashboard, IQAir, aqicn.org (CPCB ground stations), CPCB Water Quality Index reports
    </div>
  </div>

  <!-- HERO -->
  <section class="hero fade-in">
    <div class="hero-text">
      <div class="pill">EXECUTIVE SUMMARY</div>
      <h2>Average city today sits at <span>AQI 103</span> — Moderate, with a wide gap between coastal/southern cities and the northern-eastern industrial belt.</h2>
      <p>Across 15 major Indian cities, the cleanest right now is <b>Shillong</b> (AQI 28, Good) and the most polluted is <b>Dhanbad</b> (AQI 195, Moderate–Poor border). South Indian and coastal metros (Chennai, Bangalore, Kochi, Mumbai, Hyderabad, Pune) cluster in the Good–Satisfactory band, while UP, Bihar, Jharkhand, West Bengal and Rajasthan cities sit in the Moderate–Poor band.</p>
      <p>Interestingly, <b>New Delhi</b> currently reads lower (AQI 78) than several smaller cities — a reminder that AQI is highly seasonal and today's pre-monsoon snapshot won't reflect winter inversion spikes.</p>
      <div class="hero-actions">
        <button class="btn primary" onclick="document.getElementById('filters').scrollIntoView({behavior:'smooth'})">🎛 Explore the dashboard</button>
        <button class="btn" id="copySummaryBtn">📋 Copy shareable summary</button>
      </div>
    </div>
    <div class="orb-card">
      <div class="orb-wrap">
        <svg viewBox="0 0 200 200">
          <circle class="orb-bg" cx="100" cy="100" r="88"/>
          <circle class="orb-fg" id="orbCircle" cx="100" cy="100" r="88" stroke="var(--moderate)"/>
        </svg>
        <div class="orb-glow" id="orbGlow" style="background:var(--moderate);"></div>
        <div class="orb-center">
          <div class="score mono" id="orbScore">56</div>
          <div class="label">Health Score</div>
        </div>
      </div>
      <div class="orb-caption">National average Environmental Health Score (Air 60% + Water 40%) across all 15 analyzed cities — 0 worst, 100 best.</div>
    </div>
  </section>

  <!-- KEY METRICS -->
  <section>
    <div class="eyebrow">📊 Key Metrics</div>
    <div class="metrics-grid">
      <div class="metric"><span class="m-icon">📈</span><div class="m-val">103</div><div class="m-label">Average AQI</div><div class="m-sub">Moderate band (CPCB)</div></div>
      <div class="metric"><span class="m-icon">🔴</span><div class="m-val">Dhanbad</div><div class="m-label">Highest AQI City</div><div class="m-sub">AQI 195</div></div>
      <div class="metric"><span class="m-icon">🟢</span><div class="m-val">Shillong</div><div class="m-label">Lowest AQI City</div><div class="m-sub">AQI 28</div></div>
      <div class="metric"><span class="m-icon">🏙️</span><div class="m-val">15</div><div class="m-label">Cities Analyzed</div><div class="m-sub">Pan-India sample</div></div>
      <div class="metric"><span class="m-icon">💚</span><div class="m-val">56 / 100</div><div class="m-label">Avg. Health Score</div><div class="m-sub">Air 60% + Water 40%</div></div>
    </div>
  </section>

  <!-- FILTERS -->
  <section id="filters">
    <div class="eyebrow">🎛 Interactive Filters</div>
    <div class="filters-card">

      <div class="filter-group">
        <label>Focus City</label>
        <select id="citySelect"></select>
      </div>

      <div class="filter-group">
        <label>AQI Range</label>
        <div class="range-row">
          <input type="range" id="aqiMin" min="0" max="500" value="0">
          <input type="range" id="aqiMax" min="0" max="500" value="500">
        </div>
        <div class="range-vals" id="aqiRangeVal">0 – 500</div>
      </div>

      <div class="filter-group">
        <label>Pollutant (Ranking Chart)</label>
        <select id="pollutantSelect">
          <option value="aqi">AQI</option>
          <option value="pm25">PM2.5</option>
          <option value="pm10">PM10</option>
        </select>
      </div>

      <div class="filter-group">
        <label>Health Risk Level</label>
        <div class="chip-row" id="riskChips">
          <div class="chip active" data-risk="low">🟢 Low</div>
          <div class="chip active" data-risk="moderate">🟡 Moderate</div>
          <div class="chip active" data-risk="high">🔴 High</div>
        </div>
      </div>

      <div class="filter-group">
        <label>Date</label>
        <div class="range-vals" style="padding:9px 0;">Live snapshot — 12 Jun 2026<br><span style="color:var(--text-faint)">No historical series available</span></div>
      </div>

      <div class="filter-group">
        <label>Comparison Mode</label>
        <div class="toggle-row">
          <label class="switch">
            <input type="checkbox" id="compareToggle">
            <div class="slider-track"></div>
          </label>
          <span style="font-size:12.5px; color:var(--text-dim);">Compare two cities</span>
        </div>
      </div>

      <div class="filter-group" id="compareCityGroup">
        <label>Compare With</label>
        <select id="compareSelect"></select>
      </div>

    </div>
  </section>

  <!-- COMPARISON PANEL -->
  <section id="comparePanel" style="display:none;">
    <div class="eyebrow">⚖️ City Comparison</div>
    <div class="chart-card wide">
      <h3 id="compareTitle">Comparison</h3>
      <div class="ch-sub">AQI, PM2.5, PM10, Water Score and Health Score side by side</div>
      <canvas id="compareChart"></canvas>
    </div>
  </section>

  <!-- CHARTS -->
  <section>
    <div class="eyebrow">📈 Visualizations</div>
    <div class="charts-grid">
      <div class="chart-card">
        <h3>AQI Comparison</h3>
        <div class="ch-sub">Air Quality Index across filtered cities</div>
        <canvas id="aqiChart"></canvas>
      </div>
      <div class="chart-card">
        <h3>PM2.5 Comparison</h3>
        <div class="ch-sub">Fine particulate matter (µg/m³)</div>
        <canvas id="pm25Chart"></canvas>
      </div>
      <div class="chart-card">
        <h3>PM10 Comparison</h3>

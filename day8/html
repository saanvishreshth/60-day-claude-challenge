<script>
/* =========================================================
   DATA — 15 major Indian cities, snapshot 12 Jun 2026
   AQI / PM2.5 / PM10 sourced & cross-checked from aqi.in,
   IQAir and aqicn.org live monitors. Water scores are
   composite estimates from CPCB Water Quality Index reports
   and regional groundwater characteristics (0=worst,100=best).
   ========================================================= */
const CITIES = [
  {name:"Shillong",  state:"Meghalaya",      aqi:28,  pm25:14,  pm10:28,  water:78},
  {name:"Kochi",     state:"Kerala",         aqi:42,  pm25:22,  pm10:40,  water:70},
  {name:"Chennai",   state:"Tamil Nadu",     aqi:56,  pm25:32,  pm10:55,  water:48},
  {name:"Mumbai",    state:"Maharashtra",    aqi:61,  pm25:45,  pm10:70,  water:58},
  {name:"Bangalore", state:"Karnataka",      aqi:64,  pm25:38,  pm10:62,  water:52},
  {name:"Pune",      state:"Maharashtra",    aqi:71,  pm25:42,  pm10:68,  water:65},
  {name:"Hyderabad", state:"Telangana",      aqi:76,  pm25:48,  pm10:80,  water:55},
  {name:"New Delhi", state:"Delhi",          aqi:78,  pm25:58,  pm10:95,  water:45},
  {name:"Ahmedabad", state:"Gujarat",        aqi:110, pm25:65,  pm10:115, water:50},
  {name:"Jaipur",    state:"Rajasthan",      aqi:134, pm25:80,  pm10:138, water:47},
  {name:"Kolkata",   state:"West Bengal",    aqi:136, pm25:85,  pm10:140, water:50},
  {name:"Lucknow",   state:"Uttar Pradesh",  aqi:149, pm25:95,  pm10:155, water:44},
  {name:"Patna",     state:"Bihar",          aqi:165, pm25:105, pm10:175, water:42},
  {name:"Ghaziabad", state:"Uttar Pradesh",  aqi:179, pm25:115, pm10:185, water:38},
  {name:"Dhanbad",   state:"Jharkhand",      aqi:195, pm25:125, pm10:200, water:35},
];

/* ============ DERIVED HELPERS ============ */
function getCategory(aqi){
  if(aqi<=50) return {label:"Good", color:"var(--good)", risk:"low"};
  if(aqi<=100) return {label:"Satisfactory", color:"var(--satisfactory)", risk:"low"};
  if(aqi<=200) return {label:"Moderate", color:"var(--moderate)", risk:"moderate"};
  if(aqi<=300) return {label:"Poor", color:"var(--poor)", risk:"high"};
  if(aqi<=400) return {label:"Very Poor", color:"var(--verypoor)", risk:"high"};
  return {label:"Severe", color:"var(--severe)", risk:"high"};
}
function resolveVar(v){
  // resolve a css var() string to an actual hex for chart.js
  const map = {
    "var(--good)":"#4ade80","var(--satisfactory)":"#a3e635","var(--moderate)":"#facc15",
    "var(--poor)":"#fb923c","var(--verypoor)":"#ef4444","var(--severe)":"#a8323d",
    "var(--brand)":"#2dd4bf","var(--brand-2)":"#8b7cf6"
  };
  return map[v] || v;
}
function airScore(aqi){ return Math.max(0, Math.min(100, 100 - aqi/2.5)); }
function overallScore(aqi, water){ return airScore(aqi)*0.6 + water*0.4; }
function grade(score){
  if(score>=85) return "A";
  if(score>=70) return "B";
  if(score>=55) return "C";
  if(score>=40) return "D";
  return "F";
}
function gradeColor(g){
  return {A:"#4ade80",B:"#a3e635",C:"#facc15",D:"#fb923c",F:"#ef4444"}[g];
}
function waterRisk(water){
  if(water>=65) return "low";
  if(water>=45) return "moderate";
  return "high";
}
function riskIcon(r){ return {low:"🟢",moderate:"🟡",high:"🔴"}[r]; }

// precompute
CITIES.forEach(c=>{
  c.category = getCategory(c.aqi);
  c.airScore = Math.round(airScore(c.aqi));
  c.overall = Math.round(overallScore(c.aqi, c.water));
  c.aqiRisk = c.category.risk;
  c.waterRisk = waterRisk(c.water);
});

/* ============ STATE ============ */
let state = {
  selectedCity: "Mumbai",
  aqiMin: 0,
  aqiMax: 500,
  pollutant: "aqi",
  risks: new Set(["low","moderate","high"]),
  compareMode: false,
  compareCity: "New Delhi"
};

/* ============ INIT SELECTS ============ */
const citySelect = document.getElementById('citySelect');
const compareSelect = document.getElementById('compareSelect');
CITIES.forEach(c=>{
  let o1=document.createElement('option'); o1.value=c.name; o1.textContent=`${c.name} (${c.state})`;
  citySelect.appendChild(o1);
  let o2=document.createElement('option'); o2.value=c.name; o2.textContent=`${c.name} (${c.state})`;
  compareSelect.appendChild(o2);
});
citySelect.value = state.selectedCity;
compareSelect.value = state.compareCity;

/* ============ FILTERED DATA ============ */
function getFiltered(){
  return CITIES.filter(c =>
    c.aqi>=state.aqiMin && c.aqi<=state.aqiMax && state.risks.has(c.aqiRisk)
  );
}

/* ============ CHART SETUP ============ */
Chart.defaults.color = '#8d97b3';
Chart.defaults.font.family = "Inter, sans-serif";
Chart.defaults.borderColor = '#262f47';

const gridOpt = { grid:{color:'#1c2438'}, ticks:{color:'#8d97b3'} };

let aqiChart, pm25Chart, pm10Chart, distChart, rankChart, compareChart;

function makeBarChart(ctx, label){
  return new Chart(ctx, {
    type:'bar',
    data:{ labels:[], datasets:[{ label, data:[], backgroundColor:[], borderRadius:6, maxBarThickness:34 }] },
    options:{
      responsive:true,
      plugins:{ legend:{display:false} },
      scales:{ x:gridOpt, y:gridOpt }
    }
  });
}

aqiChart = makeBarChart(document.getElementById('aqiChart'), 'AQI');
pm25Chart = makeBarChart(document.getElementById('pm25Chart'), 'PM2.5 (µg/m³)');
pm10Chart = makeBarChart(document.getElementById('pm10Chart'), 'PM10 (µg/m³)');

distChart = new Chart(document.getElementById('distChart'), {
  type:'doughnut',
  data:{ labels:[], datasets:[{ data:[], backgroundColor:[], borderColor:'#0a0e1a', borderWidth:2 }] },
  options:{
    responsive:true,
    plugins:{ legend:{position:'bottom', labels:{boxWidth:12, padding:14}} }
  }
});

rankChart = new Chart(document.getElementById('rankChart'), {
  type:'bar',
  data:{ labels:[], datasets:[{ label:'AQI', data:[], backgroundColor:[], borderRadius:6 }] },
  options:{
    indexAxis:'y',
    responsive:true,
    plugins:{ legend:{display:false} },
    scales:{ x:gridOpt, y:gridOpt }
  }
});

compareChart = new Chart(document.getElementById('compareChart'), {
  type:'bar',
  data:{ labels:['AQI','PM2.5','PM10','Water Score','Health Score'], datasets:[] },
  options:{
    responsive:true,
    plugins:{ legend:{position:'bottom', labels:{color:'#edf1f7'}} },
    scales:{ x:gridOpt, y:gridOpt }
  }
});

/* ============ RENDER CHARTS ============ */
function renderCharts(){
  const data = getFiltered();
  const labels = data.map(c=>c.name);

  aqiChart.data.labels = labels;
  aqiChart.data.datasets[0].data = data.map(c=>c.aqi);
  aqiChart.data.datasets[0].backgroundColor = data.map(c=>resolveVar(c.category.color));
  aqiChart.update();

  pm25Chart.data.labels = labels;
  pm25Chart.data.datasets[0].data = data.map(c=>c.pm25);
  pm25Chart.data.datasets[0].backgroundColor = data.map(()=> '#8b7cf6');
  pm25Chart.update();

  pm10Chart.data.labels = labels;
  pm10Chart.data.datasets[0].data = data.map(c=>c.pm10);
  pm10Chart.data.datasets[0].backgroundColor = data.map(()=> '#2dd4bf');
  pm10Chart.update();

  // distribution
  const order = ["Good","Satisfactory","Moderate","Poor","Very Poor","Severe"];
  const colorMap = {Good:"#4ade80",Satisfactory:"#a3e635",Moderate:"#facc15",Poor:"#fb923c","Very Poor":"#ef4444",Severe:"#a8323d"};
  const counts = {};
  order.forEach(o=>counts[o]=0);
  data.forEach(c=> counts[c.category.label]++ );
  const nonZero = order.filter(o=>counts[o]>0);
  distChart.data.labels = nonZero;
  distChart.data.datasets[0].data = nonZero.map(o=>counts[o]);
  distChart.data.datasets[0].backgroundColor = nonZero.map(o=>colorMap[o]);
  distChart.update();

  // ranking chart (sorted by selected pollutant, ascending = cleanest first)
  const pKey = state.pollutant;
  const sorted = [...data].sort((a,b)=>a[pKey]-b[pKey]);
  document.getElementById('rankTitle').textContent =
    `City Ranking — by ${pKey==='aqi'?'AQI':pKey==='pm25'?'PM2.5':'PM10'}`;
  rankChart.data.labels = sorted.map(c=>c.name);
  rankChart.data.datasets[0].label = pKey==='aqi'?'AQI':pKey==='pm25'?'PM2.5 (µg/m³)':'PM10 (µg/m³)';
  rankChart.data.datasets[0].data = sorted.map(c=>c[pKey]);
  rankChart.data.datasets[0].backgroundColor = sorted.map(c=>resolveVar(c.category.color));
  rankChart.update();
}

/* ============ CITY CARDS ============ */
function renderCityCards(){
  const grid = document.getElementById('cityGrid');
  grid.innerHTML = '';
  const data = getFiltered();
  if(data.length===0){
    grid.innerHTML = '<div style="color:var(--text-dim); padding:20px;">No cities match the current filters. Try widening the AQI range or risk levels.</div>';
    return;
  }
  data.forEach(c=>{
    const card = document.createElement('div');
    card.className = 'city-card' + (c.name===state.selectedCity ? ' selected':'');
    card.onclick = ()=>{ state.selectedCity = c.name; citySelect.value = c.name; renderAll(); };
    card.innerHTML = `
      <div class="top-row">
        <div><div class="c-name">${c.name}</div><div class="c-state">${c.state}</div></div>
        <span class="badge" style="background:${resolveVar(c.category.color)}">${c.category.label}</span>
      </div>
      <div class="stat-row"><span>AQI</span><b>${c.aqi}</b></div>
      <div class="stat-row"><span>PM2.5</span><b>${c.pm25} µg/m³</b></div>
      <div class="stat-row"><span>PM10</span><b>${c.pm10} µg/m³</b></div>
      <div class="scores">
        <div class="score-pill"><div class="sp-val" style="color:${resolveVar(c.category.color)}">${c.airScore}</div><div class="sp-label">Air Score</div></div>
        <div class="score-pill"><div class="sp-val" style="color:#8b7cf6">${c.water}</div><div class="sp-label">Water Score</div></div>
        <div class="score-pill"><div class="sp-val" style="color:#2dd4bf">${c.overall}</div><div class="sp-label">Health Score</div></div>
      </div>
    `;
    grid.appendChild(card);
  });
}

/* ============ HEALTH ANALYSIS ============ */
function airImpactBands(aqi){
  if(aqi<=50) return {
    risk:"low",
    lungs:"Minimal irritation — air is clean enough for normal breathing without concern.",
    sleep:"No measurable impact on sleep quality or breathing at night.",
    energy:"Oxygen delivery is optimal — no pollution-related fatigue expected.",
    exercise:"Ideal conditions for outdoor running, cycling, or sports.",
    longterm:"Negligible added risk to lungs or heart from current air quality."
  };
  if(aqi<=100) return {
    risk:"low",
    lungs:"Mild irritation possible for sensitive individuals (asthma, allergies).",
    sleep:"Generally unaffected, though sensitive groups may notice slight congestion.",
    energy:"Normal energy levels for most people.",
    exercise:"Safe for most outdoor activity; sensitive groups should monitor symptoms.",
    longterm:"Low cumulative risk if exposure stays mostly in this range."
  };
  if(aqi<=200) return {
    risk:"moderate",
    lungs:"Increased throat/lung irritation, occasional coughing, especially for sensitive groups.",
    sleep:"Possible disruption from nasal congestion or throat dryness overnight.",
    energy:"Mild fatigue can build up due to reduced oxygen-exchange efficiency.",
    exercise:"Shorten or move high-intensity cardio indoors, especially for children, elderly and asthmatics.",
    longterm:"Sustained exposure raises risk of chronic bronchitis and reduced lung function over years."
  };
  if(aqi<=300) return {
    risk:"high",
    lungs:"Significant irritation, breathlessness likely even in healthy adults.",
    sleep:"Noticeable disruption — congestion, dry throat, coughing at night.",
    energy:"Noticeable daytime fatigue and reduced stamina.",
    exercise:"Avoid outdoor exercise; use indoor workouts with air purification.",
    longterm:"Meaningfully elevated cardiovascular and respiratory risk with repeated exposure."
  };
  return {
    risk:"high",
    lungs:"Severe irritation — breathing difficulty possible for all groups, not just sensitive ones.",
    sleep:"Major disruption likely; consider sealing windows and running purifiers overnight.",
    energy:"Substantial fatigue and reduced concentration are common.",
    exercise:"All outdoor exercise should be avoided; N95/N99 mask required if going out.",
    longterm:"High long-term cardiovascular, respiratory and neurological risk with continued exposure."
  };
}

function waterImpactBands(water){
  if(water>=65) return {
    risk:"low",
    hairfall:"Minimal mineral/contaminant load — little to no impact on hair shedding.",
    hairdry:"Hair retains natural moisture well; minimal dryness from washing water.",
    scalp:"Scalp microbiome generally stays balanced.",
    skindry:"Minimal stripping of skin's natural oils after washing.",
    acne:"Low risk of mineral/contaminant-related breakouts.",
    sensitive:"Low irritation risk for sensitive skin types."
  };
  if(water>=45) return {
    risk:"moderate",
    hairfall:"Moderately hard/treated water may mildly increase shedding over time.",
    hairdry:"Hair can feel drier and less manageable after a few weeks of regular use.",
    scalp:"Occasional dryness or flaking possible, especially in dry weather.",
    skindry:"Mild tightness or dryness after showers, particularly in winter.",
    acne:"Moderate risk — mineral buildup on skin can contribute to clogged pores.",
    sensitive:"Occasional reactions (redness, mild itching) possible for sensitive skin."
  };
  return {
    risk:"high",
    hairfall:"Elevated hair fall risk linked to hardness/contaminant levels — consider a filter.",
    hairdry:"Significant dryness and brittleness likely with regular tap-water washing.",
    scalp:"Higher chance of dandruff, itchiness and scalp irritation.",
    skindry:"Pronounced dryness — natural oils are stripped more aggressively.",
    acne:"Elevated risk of breakouts from mineral/contaminant buildup on skin.",
    sensitive:"High irritation risk — filtered or boiled-and-cooled water recommended for washing face."
  };
}

function renderHealthAnalysis(){
  const c = CITIES.find(x=>x.name===state.selectedCity);
  document.getElementById('healthTitle').textContent = `Selected City: ${c.name}`;

  const air = airImpactBands(c.aqi);
  document.getElementById('airHcSub').textContent = `AQI ${c.aqi} · ${c.category.label} · PM2.5 ${c.pm25} µg/m³ · PM10 ${c.pm10} µg/m³`;
  const airRows = [
    ["Lungs", air.lungs],
    ["Sleep", air.sleep],
    ["Energy Levels", air.energy],
    ["Exercise Performance", air.exercise],
    ["Long-term Health", air.longterm],
  ];
  document.getElementById('airImpacts').innerHTML = airRows.map(r=>`
    <div class="impact-row">
      <div class="imp-label">${r[0]}</div>
      <div class="imp-text">${r[1]}</div>
      <div class="risk-tag">${riskIcon(air.risk)}</div>
    </div>`).join('');

  const water = waterImpactBands(c.water);
  document.getElementById('waterHcSub').textContent = `Water Quality Score ${c.water}/100`;
  const waterRows = [
    ["Hair Fall", water.hairfall],
    ["Hair Dryness", water.hairdry],
    ["Scalp Health", water.scalp],
    ["Skin Dryness", water.skindry],
    ["Acne", water.acne],
    ["Sensitive Skin", water.sensitive],
  ];
  document.getElementById('waterImpacts').innerHTML = waterRows.map(r=>`
    <div class="impact-row">
      <div class="imp-label">${r[0]}</div>
      <div class="imp-text">${r[1]}</div>
      <div class="risk-tag">${riskIcon(water.risk)}</div>
    </div>`).join('');
}

/* ============ REPORT CARD ============ */
function renderReportCard(){
  const c = CITIES.find(x=>x.name===state.selectedCity);
  document.getElementById('rcCity').textContent = c.name;
  document.getElementById('rcScore').textContent = c.overall;
  document.getElementById('rcScore').style.color = gradeColor(grade(c.overall));

  document.getElementById('rcAirVal').textContent = c.airScore;
  document.getElementById('rcWaterVal').textContent = c.water;
  document.getElementById('rcOverallVal').textContent = c.overall;
  document.getElementById('rcAirBar').style.width = c.airScore+'%';
  document.getElementById('rcWaterBar').style.width = c.water+'%';
  document.getElementById('rcOverallBar').style.width = c.overall+'%';
  document.getElementById('rcAirBar').style.background = resolveVar(c.category.color);

  const airG = grade(c.airScore);
  const waterG = grade(c.water);
  // hair/skin risk grade: same scale as water (higher water score = better grade = lower risk)
  document.getElementById('gradeAir').textContent = airG;
  document.getElementById('gradeAir').style.color = gradeColor(airG);
  document.getElementById('gradeWater').textContent = waterG;
  document.getElementById('gradeWater').style.color = gradeColor(waterG);
  document.getElementById('gradeHair').textContent = waterG;
  document.getElementById('gradeHair').style.color = gradeColor(waterG);
  document.getElementById('gradeSkin').textContent = waterG;
  document.getElementById('gradeSkin').style.color = gradeColor(waterG);
}

